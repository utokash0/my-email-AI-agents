# ── ANTHROPIC ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── SERVER ─────────────────────────────────────────────────────────
PORT=3000

# ── MONGODB ────────────────────────────────────────────────────────
# Paste your MongoDB Atlas connection string here
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/email_agents
MONGODB_URI=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/email_agents?retryWrites=true&w=majority

# ── AUTH ───────────────────────────────────────────────────────────
# Change this to any long random string before deploying
JWT_SECRET=change-this-to-a-long-random-string-nobody-can-guess

# ── ADMIN SEED (used only when running: node db/seed.js) ───────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@youragency.com
ADMIN_PASSWORD=changeme123